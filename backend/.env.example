# ============================================================
# Nyaya-ZTA Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your actual values.
# Never commit .env to version control.
# ============================================================

# ── Application ──────────────────────────────────────────────
APP_NAME=Nyaya-ZTA
APP_VERSION=0.1.0
ENVIRONMENT=development
DEBUG=true
LOG_LEVEL=DEBUG

# ── Server ───────────────────────────────────────────────────
HOST=0.0.0.0
PORT=8000
# Comma-separated list of allowed CORS origins
CORS_ORIGINS=http://localhost:3000,http://localhost:3001
API_PREFIX=/api/v1

# ── Supabase ─────────────────────────────────────────────────
# Get these from: https://supabase.com → Project Settings → API
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here
# Get this from: Project Settings → API → JWT Secret
SUPABASE_JWT_SECRET=your-jwt-secret-here

# ── Database ─────────────────────────────────────────────────
# Get from: Project Settings → Database → Connection string (URI)
# Use the "Session mode" pooler connection for application use:
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:6543/postgres
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10
DB_POOL_TIMEOUT=30
DB_ECHO=false

# ── LLM (Groq — OpenAI-compatible) ──────────────────────────
# Get API key from: https://console.groq.com → API Keys
LLM_PROVIDER=groq
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=your-groq-api-key-here
LLM_MODEL=llama-3.3-70b-versatile
LLM_MAX_TOKENS=4096
LLM_TEMPERATURE=0.1
LLM_TIMEOUT=60

# ── RAG Configuration ───────────────────────────────────────
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIMENSION=384
FAISS_INDEX_PATH=faiss_indices
RAG_TOP_K=5
RAG_SIMILARITY_THRESHOLD=0.3
RAG_MAX_CONTEXT_TOKENS=3000
CHUNK_SIZE=512
CHUNK_OVERLAP=50

# ── Security ────────────────────────────────────────────────
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# ── Ledger ──────────────────────────────────────────────────
LEDGER_SIGNING_KEY_PATH=signing_keys/ledger_key.pem
LEDGER_BLOCK_SIZE=50
LEDGER_AUTO_FINALIZE=true

# ── Rate Limiting ───────────────────────────────────────────
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_WINDOW_SECONDS=60

# ── Monitoring ──────────────────────────────────────────────
ENABLE_REQUEST_LOGGING=true

# ── Enterprise Secrets Management ────────────────────────────
# Active provider: "env" | "aws" | "vault" | "auto"
SECRETS_PROVIDER=env

# AWS Secrets Manager Configuration
AWS_SECRET_NAME=nyaya-zta/production
AWS_REGION=us-east-1

# HashiCorp Vault Configuration
VAULT_ADDR=http://localhost:8200
VAULT_TOKEN=your-vault-token-here
VAULT_SECRET_PATH=nyaya-zta/config
VAULT_MOUNT_POINT=secret

